---
import '@/styles/global.css'
import Seo from '@/components/seo/Seo.astro'
import Analytics from '@vercel/analytics/astro'
import { SITE } from '@/config/site'
import type { ComponentProps } from 'astro/types'

type Props = ComponentProps<typeof Seo>
const seo = Astro.props
// Analítica: solo en producción y solo si hay variables definidas (ver .env.example).
const plausibleDomain = import.meta.env.PROD ? import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN : undefined
const clarityId = import.meta.env.PROD ? import.meta.env.PUBLIC_CLARITY_ID : undefined
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/png" href="/img/isotipo.png" />
    <link rel="preload" href="/fonts/InterTight.woff2" as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    {plausibleDomain && <script is:inline defer data-domain={plausibleDomain} src="https://plausible.io/js/script.outbound-links.js"></script>}
    {plausibleDomain && <script is:inline>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}</script>}
    {clarityId && <script is:inline set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${clarityId}");`} />}
    {import.meta.env.PROD && <Analytics />}
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import { startSmoothScroll, scrollToId } from '@/lib/scroll'
      startSmoothScroll()
      // Enlaces estáticos a secciones (/#id): scroll suave con descuento de la barra flotante.
      document.addEventListener('click', (e) => {
        if (e.defaultPrevented) return
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="/#"]')
        if (a && scrollToId(a.getAttribute('href')!.slice(2))) e.preventDefault()
      })
    </script>
  </body>
</html>
