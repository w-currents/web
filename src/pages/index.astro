---
import Base from '@/layouts/Base.astro'
import { SITE } from '@/config/site'
import { CONTACT } from '@/content/site'
import Nav from '@/features/nav/Nav'
import Hero from '@/features/hero/Hero.astro'
import Empresa from '@/features/empresa/Empresa'
import Servicios from '@/features/servicios/Servicios'
import Metodo from '@/features/metodo/Metodo'
import Proyectos from '@/features/proyectos/Proyectos'
import Certificaciones from '@/features/certificaciones/Certificaciones'
import Cotizador from '@/features/cotizador/Cotizador'
import { Footer } from '@/features/footer/Footer'
import WhatsApp from '@/features/whatsapp/WhatsApp'
import Paleta from '@/features/dev/Paleta'

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    alternateName: ['w-currents', 'wcurrents Ingeniería'],
    url: SITE.url,
    logo: `${SITE.url}/img/isotipo.png`,
    description: SITE.description,
    email: CONTACT.email,
    telephone: CONTACT.phone,
    address: { '@type': 'PostalAddress', addressLocality: 'Santiago', addressCountry: 'CL' },
    contactPoint: { '@type': 'ContactPoint', contactType: 'sales', telephone: CONTACT.phone, email: CONTACT.email, areaServed: 'CL', availableLanguage: 'es' },
    areaServed: { '@type': 'Country', name: 'Chile' },
    knowsAbout: ['Corrientes débiles', 'Ingeniería de infraestructura crítica', 'Cableado estructurado', 'CCTV', 'Control de acceso', 'Fibra óptica', 'Protección contra incendios', 'Automatización industrial', 'Telecomunicaciones', 'Seguridad electrónica', 'Instrumentación'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'w-currents',
    url: SITE.url,
    inLanguage: 'es-CL',
    publisher: { '@id': `${SITE.url}/#organization` },
  },
]
---
<Base path="/" jsonLd={jsonLd}>
  <Nav client:load />
  <main>
    <Hero />
    <Empresa client:visible />
    <Servicios client:visible />
    <Metodo client:visible />
    <Proyectos client:visible />
    <Certificaciones client:visible />
    <Cotizador client:visible />
  </main>
  <Footer />
  <WhatsApp client:idle />
  {import.meta.env.DEV && <Paleta client:only="react" />}
</Base>
